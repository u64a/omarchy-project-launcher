#!/usr/bin/python -I

import os
import runpy

project_dir = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
os.environ.setdefault("OMARCHY_PROJECT_LAUNCHER_USER_PATH", os.environ.get("PATH", ""))
os.environ["PATH"] = "/usr/bin"
runpy.run_path(
    os.path.join(project_dir, "src", "omarchy_project_launcher.py"),
    run_name="__main__",
)
